{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"semi": false,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "none",
	"arrowParens": "always",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"embeddedLanguageFormatting": "off",
	"sortPackageJson": false,
	"sortImports": {
		"newlinesBetween": false,
		"partitionByNewline": true
	},
	"ignorePatterns": [
		"packages/devtools/src/*/fixtures/**",
		"packages/generator/src/validate/schemas/*.json",
		"packages/generator/test/fixtures/**",
		"packages/generator/corpus/fixtures/**",
		"packages/generator/corpus/verdicts/**"
	]
}
