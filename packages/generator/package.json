{
	"name": "effect-openapi-cli-generator",
	"version": "0.0.0",
	"private": true,
	"description": "Generate Effect-native CLIs from OpenAPI specifications: one directory per pipeline stage under src/, the generated CLIs' runtime under src/runtime-src/, the pinned corpus under corpus/.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#package.json": "./package.json",
		"#tsconfig.json": "./tsconfig.json",
		"#test/*": "./test/*",
		"#corpus/*": "./corpus/*",
		"#scripts/*": "./scripts/*",
		"#runtime/*": "./src/runtime-src/runtime/*",
		"#domain/*": "./src/runtime-src/domain/*",
		"#*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"effect-openapi-cli-generator": "./src/bin.ts"
	},
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"typecheck": "node scripts/ratchet.ts typecheck",
		"superlint": "node scripts/ratchet.ts superlint",
		"oxlint": "node scripts/ratchet.ts oxlint",
		"runtime-gate": "node scripts/runtime-gate.ts",
		"test": "vitest run",
		"corpus": "scripts/memguard.sh 6144 -- node corpus/tools/run.ts --check",
		"ratchet:lower": "node scripts/ratchet.ts typecheck --lower && node scripts/ratchet.ts superlint --lower && node scripts/ratchet.ts oxlint --lower"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@hyperjump/json-schema": "catalog:",
		"@superstarter/json": "workspace:*",
		"@types/node": "catalog:",
		"arkregex": "catalog:",
		"effect": "catalog:",
		"typescript": "catalog:",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@superstarter/devtools": "workspace:*",
		"@superstarter/testing": "workspace:*",
		"oxfmt": "catalog:",
		"vitest": "catalog:"
	}
}
