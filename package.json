{
	"name": "effect-openapi-cli-generator-workspace",
	"private": true,
	"type": "module",
	"imports": {
		"#package.json": "./package.json"
	},
	"packageManager": "pnpm@12.16.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	},
	"scripts": {
		"prepare": "effect-tsgo patch",
		"check": "turbo run typecheck superlint oxlint fixtures:superlint fixtures:style fixtures:oxlint fixtures:react-compiler format dead-code architecture dedupe",
		"lint": "turbo run superlint oxlint dead-code architecture",
		"test": "turbo run test",
		"corpus": "turbo run corpus",
		"fuzz": "node packages/testing/scripts/fuzz.ts",
		"mutate": "node packages/testing/scripts/mutate.ts",
		"format:write": "oxfmt . && turbo run oxlint -- --fix && oxfmt .",
		"typecheck": "effect-tsgo tsrs",
		"superlint": "superlint",
		"oxlint": "oxlint oxlint.config.ts",
		"format": "oxfmt --check .",
		"dead-code": "node packages/generator/scripts/ratchet.ts dead-code",
		"architecture": "node packages/generator/scripts/ratchet.ts architecture",
		"dedupe": "pnpm dedupe --check",
		"ratchet:lower": "pnpm --filter effect-openapi-cli-generator run ratchet:lower && node packages/generator/scripts/ratchet.ts dead-code --lower && node packages/generator/scripts/ratchet.ts architecture --lower"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@superstarter/devtools": "workspace:*",
		"@superstarter/testing": "workspace:*",
		"@types/node": "catalog:",
		"fallow": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	},
	"superlint": {
		"appDatabase": "none",
		"effectFree": [],
		"exceptions": [
			{
				"rule": "no-module-state",
				"files": [
					"packages/testing/src/vitest/coverage.ts"
				]
			}
		],
		"sqlLeafOwnersOnly": {
			"owners": []
		},
		"sqlCastOwner": {
			"owners": []
		},
		"sqlJsonOwner": {
			"owners": []
		},
		"sqlDynamicSchema": {
			"tableFactories": []
		},
		"sqlQueryDeadline": {
			"files": [],
			"properties": [],
			"refusals": [],
			"admitted": []
		},
		"sqlRawExecution": {
			"statementOwners": [],
			"copyStreamOwners": [],
			"nativeClientOwners": [],
			"declaredExecutions": []
		},
		"sqlRawStatement": {
			"recursiveEnvelopeOwners": [],
			"projectionEnvelopeOwners": [],
			"declaredStatements": []
		},
		"uncheckedVocabularyLiteral": {
			"support": [],
			"vocabularies": [],
			"titled": [
				"describe",
				"it",
				"effect",
				"live",
				"each"
			],
			"explanations": [
				"message"
			]
		}
	}
}
