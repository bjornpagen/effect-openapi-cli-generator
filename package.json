{
	"name": "effect-openapi-cli-generator-workspace",
	"private": true,
	"type": "module",
	"imports": {
		"#toolchain.config.ts": "./toolchain.config.ts"
	},
	"packageManager": "pnpm@12.16.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	},
	"scripts": {
		"prepare": "effect-tsgo patch",
		"check": "turbo run typecheck runtime-gate benchmark superlint oxlint format dead-code architecture dedupe --filter=./packages/* --filter=// --continue=dependencies-successful",
		"lint": "turbo run superlint oxlint dead-code architecture --filter=./packages/* --filter=//",
		"test": "turbo run test --filter=./packages/*",
		"test:grizzle": "pnpm --filter effect-openapi-cli-generator run test:grizzle",
		"corpus": "turbo run corpus --filter=./packages/*",
		"fuzz": "node vendor/toolchain/packages/testing/scripts/fuzz.ts",
		"mutate": "bjornpagen-mutate",
		"format:write": "oxfmt . && turbo run oxlint --filter=./packages/* --filter=// -- --fix && oxfmt .",
		"typecheck": "effect-tsgo tsrs",
		"superlint": "superlint",
		"oxlint": "oxlint oxlint.config.ts",
		"format": "oxfmt --check .",
		"dead-code": "node packages/generator/scripts/ratchet.ts dead-code",
		"architecture": "fallow architecture",
		"dedupe": "pnpm dedupe --check",
		"ratchet:lower": "pnpm --filter effect-openapi-cli-generator run ratchet:lower && node packages/generator/scripts/ratchet.ts dead-code --lower"
	},
	"devDependencies": {
		"@bjornpagen/devtools": "workspace:*",
		"@bjornpagen/testing": "workspace:*",
		"@effect/tsgo": "catalog:",
		"@types/node": "catalog:",
		"fallow": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
